# Copy to .env and edit. Every value here is optional — ttskit works with none
# of them set. Real environment variables always win over this file.

# --- engine ----------------------------------------------------------------
# edge   = Microsoft neural voices, free, online, reports word timings
# kokoro = Kokoro-82M, free, fully offline on CPU (needs: ttskit models download)
TTSKIT_ENGINE=edge
TTSKIT_DEFAULT_VOICE=alloy

# --- delivery --------------------------------------------------------------
TTSKIT_RATE=+0%
TTSKIT_VOLUME=+0%
TTSKIT_PITCH=+0Hz

# --- long-form pipeline ----------------------------------------------------
TTSKIT_MAX_CHUNK_CHARS=2000
TTSKIT_PARAGRAPH_GAP_MS=500
TTSKIT_HEADING_GAP_MS=900
TTSKIT_CONCURRENCY=6
TTSKIT_RETRIES=3

# --- server ----------------------------------------------------------------
TTSKIT_HOST=127.0.0.1
TTSKIT_PORT=5050
# Leave empty to accept any key (the usual choice for a local server).
# Set a value to require `Authorization: Bearer <value>`.
TTSKIT_API_KEY=

# --- paths -----------------------------------------------------------------
# TTSKIT_CACHE_DIR=~/.cache/ttskit
# TTSKIT_FFMPEG=/usr/local/bin/ffmpeg
# TTSKIT_KOKORO_MODEL=/path/to/kokoro-v1.0.onnx
# TTSKIT_KOKORO_VOICES=/path/to/voices-v1.0.bin

# --- speech to text --------------------------------------------------------
# tiny | base | small | medium | large-v3
TTSKIT_WHISPER_MODEL=base

# --- networks that inspect TLS ---------------------------------------------
# Point this at your corporate CA bundle if edge-tts fails to verify the
# certificate for speech.platform.bing.com.
# TTSKIT_CA_BUNDLE=/path/to/ca-bundle.crt
# TTSKIT_PROXY=http://proxy.internal:8080
